{
  "name": "funcaster-console",
  "version": "0.2.0",
  "private": true,
  "description": "Walk-up motion-controlled party games for one to four phones.",
  "license": "MIT",
  "author": "Patrick Sun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raihankhan-rk/funcaster.git"
  },
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tv": "open -na 'Google Chrome' --args --user-data-dir=$HOME/.openwii-chrome --no-first-run --no-default-browser-check --autoplay-policy=no-user-gesture-required --new-window https://localhost:8443/",
    "dev": "node --watch server.js",
    "cert": "node scripts/gen-cert.js",
    "test": "node tests/kart-prototype/server.cjs",
    "build:kart-assets": "node games/mario-kart/pipeline/build.mjs",
    "test:kart-browser": "node games/mario-kart/browser-evidence.mjs",
    "test:kart-public": "node games/mario-kart/public-review.mjs",
    "test:unit": "node --test \"core/**/*.test.mjs\" \"games/**/*.test.mjs\" \"tests/kart-prototype/*.test.mjs\"",
    "test:kart-fallback": "node games/mario-kart/public-review.mjs --fallback",
    "test:party": "node --test tests/party/*.test.cjs",
    "share": "node scripts/share.cjs",
    "check": "npm run validate:games && npm run test:unit && npm run test:party",
    "validate:games": "node scripts/validate-games.mjs",
    "format:check": "prettier --check core/catalog.js core/state.js server/party.cjs server/records.cjs public/party/host.js public/party/phone.js",
    "game:create": "node scripts/create-game.mjs",
    "game:validate": "node scripts/validate-games.mjs",
    "replay:check": "node scripts/replay-check.cjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4"
  }
}
